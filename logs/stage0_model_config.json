    "corona_factor": "1 + 0.5*corona_score",
    "mucus_retention": "0.25*size_retention + 0.25*hydrophobicity_score + 0.20*surface_score + 0.15*shape_retention + 0.15*mucus_thickness_factor",
    "p_mcell": "sigmoid(1.20*small_size_score + 0.80*surface_score + 0.70*corona_score + 0.60*m_cell_uptake_factor + 0.50*peyer_patch_uptake_factor - 0.80*effective_size_norm)",
    "gut_to_lymph_translocation": "0.30*p_mcell + 0.20*mucus_retention + 0.20*barrier_impairment + 0.15*lymph_flow_factor + 0.15*surface_score",
    "mln_retention": "0.30*gut_to_lymph_translocation + 0.25*macrophage_sensitivity + 0.20*corona_score + 0.15*shape_retention + 0.10*clearance_inverse",
    "immune_risk_index": "0.20*gut_to_lymph_translocation + 0.20*mln_burden_norm + 0.15*macrophage_activation + 0.15*ros_score + 0.15*cytokine_score + 0.10*systemic_spillover_norm + 0.05*barrier_impairment"
